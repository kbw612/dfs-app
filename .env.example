# Copy to .env and adjust as needed. All vars are optional -- sensible
# defaults are set in backend/config.py.

DFS_APP_NFL_DEPTH_CHART_URL=https://www.footballguys.com/depthcharts?type=all&1=2
DFS_APP_SNAPSHOTS_DIR=./data/snapshots
DFS_APP_TEAM_INFO_CSV=./config/team-info.csv
DFS_APP_USAGE_BUMP_PLAYERS_JSON=./config/usage-bump-players.json
DFS_APP_FRONTEND_ORIGIN=http://localhost:5173

# Ownership/leverage scraping -- required (no default) to actually run a
# scrape; oneweekseason.com is a login-gated site. Never commit real
# values -- this file is the template, .env itself is gitignored.
DFS_APP_OWNERSHIP_SOURCE_URL=https://oneweekseason.com
DFS_APP_OWNERSHIP_SOURCE_USERNAME=
DFS_APP_OWNERSHIP_SOURCE_PASSWORD=
DFS_APP_OWNERSHIP_SNAPSHOTS_DIR=./data/ownership_snapshots
DFS_APP_OWNERSHIP_LEVERAGE_TIERS_JSON=./config/ownership-leverage-tiers.json
